Network_v2c_community=public

# --- Integrations (optional; for lib/integrations/*) ---
JIRA_BASE_URL=http://172.16.10.6:8080
JIRA_PROJECT=MOTADATA
# Jira Server/DC: a personal access token, sent as Bearer (preferred — this is what
# 172.16.10.6 accepts). Basic USERNAME/PASSWORD still works if you have no token.
JIRA_TOKEN=
JIRA_USERNAME=
JIRA_PASSWORD=
# Jira Cloud only: set to 1 to authenticate as Basic JIRA_EMAIL:JIRA_TOKEN instead
JIRA_CLOUD=
JIRA_EMAIL=
TFS_BASE_URL=
TFS_PROJECT=
TFS_PAT=

# --- Azure DevOps Test Plans (push manual cases into MOTADATA-<jiraId> suites) ---
# Same server as TFS_* above; these fall back to TFS_BASE_URL / TFS_PROJECT / TFS_PAT.
AZURE_ORG_URL=https://ad-motadata:8443/Motadata
AZURE_PROJECT=Motadata
AZURE_PAT=
# Plan the MOTADATA-<jiraId> folders are WRITTEN to. Find it in the plan URL:
#   .../_testPlans/define?planId=79474  ->  79474 (Automation_Sample_TestPlan)
# NOT 41621 — that is the read-only plan tfs-import imports FROM; never publish into it.
AZURE_TEST_PLAN_ID=79474
# Optional — nest the folders under this suite instead of the plan root
AZURE_PARENT_SUITE_ID=
# The three metadata columns of the manual-test-case format.
AZURE_AREA_PATH=Motadata\Settings
# Assigned To precedence: --assigned-to > AZURE_ASSIGNED_TO > the ticket's Jira reporter
# > unset (ADO then falls back to the PAT owner). LEAVE BLANK to follow the reporter —
# setting it pins every case to one person regardless of who raised the ticket.
AZURE_ASSIGNED_TO=
AZURE_STATE=Design
# Display name written into the CSV's "Assigned To" column (TFS CSV import wants a display
# name, e.g. "Ansh Garg"). The API path ignores this and uses DOMAIN\account instead —
# see AZURE_ASSIGNED_TO / AZURE_IDENTITY_DOMAIN.
CSV_ASSIGNED_TO=
# AD domain prefixed to the Jira reporter's account name: gaurang.kalani -> MOTADATA\gaurang.kalani.
# ADO on this server cannot resolve users by email, only by DOMAIN\account.
AZURE_IDENTITY_DOMAIN=MOTADATA
# On-prem ADO Server rejects 7.x. These defaults (6.0 / 6.0-preview.1 / 6.0-preview.2) are
# probed-correct for ad-motadata:8443; override only if pointing at dev.azure.com.
AZURE_WIT_API=
AZURE_PLAN_API=
AZURE_SUITE_CASE_API=
# Set to 1 for on-prem servers with a self-signed cert
AZURE_INSECURE=
