{
  "name": "playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:monitors": "playwright test tests/Monitors",
    "test:monitors:list": "playwright test tests/Monitors --list",
    "test:dashboard": "playwright test tests/Dashboard",
    "test:dashboard:list": "playwright test tests/Dashboard --list",
    "test:dashboard:baseline": "cross-env DASHBOARD_BASELINE=write playwright test tests/Dashboard",
    "test:dashboard:strict": "cross-env DASHBOARD_STRICT_EMPTY=1 playwright test tests/Dashboard",
    "reports:validate": "cross-env TRAP_FIRE=0 playwright test --project=reports tests/Reports/report-validation.spec.js --reporter=html,line,./tests/Reports/_core/html-reporter.js",
    "reports:validate:list": "playwright test --project=reports tests/Reports/report-validation.spec.js --list",
    "reports:create": "cross-env TRAP_FIRE=0 playwright test --project=reports tests/Reports/report-creation.spec.js --reporter=html,line,./tests/Reports/_core/html-reporter.js",
    "reports:extract": "node tests/Reports/_core/extract-ids.js",
    "reports:report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "cross-env": "^10.1.0",
    "node-ssh": "^13.2.1"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "nodejs-winrm": "^1.1.3",
    "pdfjs-dist": "^4.7.76",
    "ssh2": "^1.17.0"
  }
}
