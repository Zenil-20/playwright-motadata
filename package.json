{
  "name": "playwright-motadata",
  "version": "1.0.0",
  "description": "Motadata AIOps Playwright QA — data-driven suite + AI test pipeline",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:discovery": "playwright test --project discovery_data_driven",
    "test:settings": "playwright test --project settings_02_discovery",
    "report": "playwright show-report",
    "pipeline": "node framework/core/orchestration/daily-pipeline.mjs",
    "pipeline:dry": "node framework/core/orchestration/daily-pipeline.mjs --dry",
    "test:gates": "node --test governance/validation/validators.test.js",
    "gate": "node governance/validation/cli.mjs",
    "compile": "playwright test --list",
    "sync:claude": "node scripts/sync-claude.mjs",
    "gen:screens": "node scripts/gen-screen-knowledge.mjs",
    "coverage-gate": "node scripts/coverage-gate.mjs",
    "tfs:import": "node scripts/tfs-import.mjs",
    "ado:publish": "node scripts/ado-publish.mjs",
    "cases": "node scripts/cases.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "ssh2": "^1.17.0"
  }
}
